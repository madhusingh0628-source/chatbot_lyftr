# Copy to .env and fill in. NEVER commit .env.

# Comma-separated key pool, no spaces. Order = key_1, key_2, ...
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key

# LiteLLM model name (provider/model), used for every key...
LLM_MODEL=gemini/gemini-2.0-flash
# ...unless LLM_MODELS gives one model per key (same order as LLM_API_KEYS), e.g.
# LLM_MODELS=groq/llama-3.1-8b-instant,gemini/gemini-2.5-flash
LLM_MODELS=

# SQLite location. Four slashes = absolute path (/data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true

# Seconds to wait for one provider call before failing over to the next key
LLM_TIMEOUT=30

# How many past messages are sent to the LLM with each request (0 = all).
# The full history is always stored and shown; this only bounds the prompt size.
MAX_HISTORY_MESSAGES=100

# Default system prompt when the client sends none
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Frontend build-time: backend URL the browser calls
VITE_API_URL=http://localhost:8000
